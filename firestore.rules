rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function tenant() {
      return request.auth != null ? request.auth.token.tenantId : null;
    }

    match /tenants/{tenantId} {
      allow read: if tenant() == tenantId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId && tenant() == resource.data.tenantId;
    }

    match /tCollections/{tenantId}/{document=**} {
      allow read, write: if true;
    }
    
    match /tCollections/{tenantId}/assemblies/{assemblyId}/questions/{questionId}/votes/{voteId} {
      allow read, write: if true;
    }
  }
}
